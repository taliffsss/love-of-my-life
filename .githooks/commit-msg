#!/usr/bin/env bash
# commit-msg: Conventional Commits. "type(scope): summary", for example "feat(photos): require a plan before uploading".
# Types: feat fix docs style refactor perf test build ci chore revert. Merge, revert, fixup! and squash! commits pass as they are.
set -euo pipefail
msg_file="$1"
first="$(grep -v '^#' "$msg_file" | sed -e '/./,$!d' | head -n 1)"

case "$first" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! [[ "$first" =~ $pattern ]]; then
  cat >&2 <<MSG
commit-msg: the first line must follow Conventional Commits:

    type(scope): summary          e.g.  fix(landing): keep the sample card inside the phone

  types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  yours: ${first:-<empty>}
MSG
  exit 1
fi

if [ "${#first}" -gt 100 ]; then
  echo "commit-msg: the first line is ${#first} characters; keep it to 100 or fewer." >&2
  exit 1
fi
