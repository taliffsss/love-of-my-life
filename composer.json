{
    "name": "taliffsss/love-of-my-life",
    "description": "A private romantic photo slideshow and love letter, built on the NaluzPHP framework.",
    "type": "project",
    "license": "proprietary",
    "version": "2.3.2",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "chillerlan/php-qrcode": "^5.0",
        "naluz/framework": "^1.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Naluz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "@php naluz run:server",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php naluz key:generate"
        ],
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "cs-fix": "phpcbf",
        "hooks": "@php -r \"is_dir('.git') && shell_exec('git config core.hooksPath .githooks');\"",
        "post-install-cmd": [
            "@hooks"
        ],
        "check": [
            "@cs",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
