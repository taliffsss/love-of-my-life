# Ready for local development (php naluz run:server). Production values: deploy/.env.production.example
APP_NAME="Love of My Life"
APP_ENV=local
APP_DEBUG=true
# The public URL of the product (landing page, sign-in, dashboard)
APP_URL=http://localhost:8000
# Domain the pages' own addresses live under: <name>.SAAS_DOMAIN (Forever plan). Defaults to the host of APP_URL.
# Browsers send *.localhost to your machine, so http://<name>.localhost:8000/ works locally.
SAAS_DOMAIN=localhost
APP_KEY=
APP_TIMEZONE=UTC
JWT_SECRET=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

# Cookies are marked Secure on HTTPS automatically; set true/false to force it.
SESSION_SECURE=

# Accounts, pages, photos and orders. SQLite by default (storage/database.sqlite); MySQL/PostgreSQL also work.
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# PostgreSQL instead (createdb lovable; then php naluz migrate):
# DB_CONNECTION=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=lovable
# DB_USERNAME=you
# DB_PASSWORD=
# (tables go to the database's default schema, public; NaluzPHP 1.3 does not read DB_SCHEMA)

# none = customers see how to pay (GCash/Maya) and you activate the plan: php bin/grant-plan.php <order reference>
# fake = test checkout with a "pay" button (only for APP_ENV=local, testing, development or staging)
# paymongo / xendit = hosted checkout; the provider's webhook marks the order paid (set the keys below)
PAYMENTS_DRIVER=fake
# PAYMENTS_MANUAL_INSTRUCTIONS="Send the amount by GCash to 0917 000 0000 and message us the reference."

# PayMongo: webhook for checkout_session.payment.paid at <APP_URL>/api/webhooks/paymongo (its signing secret below)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# PAYMONGO_METHODS=gcash,paymaya,card,grab_pay
# Xendit: Invoices paid + expired webhooks at <APP_URL>/api/webhooks/xendit (the dashboard's verification token below)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---- Photo storage (DigitalOcean Spaces) -------------------------------------------------
# Without these, photos are stored in public/storage (fine for local development only).

SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_REGION=nyc3
# Regional endpoint, without the bucket name
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# Folder (prefix) inside the bucket where photos are stored (pages/<page>/… under it)
SPACES_FOLDER=yam
# Public CDN origin used for the photo links
SPACES_CDN_URL=

# Sign in with Google / Facebook (optional; a provider is on when both of its values are set).
# Redirect URIs to register: <APP_URL>/auth/google/callback and <APP_URL>/auth/facebook/callback
# Facebook needs a consumer-login app with the "email" permission (a Business-type app cannot do Facebook Login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_API_VERSION=v26.0

# Administrator for `php naluz db:seed` (required outside local environments, 12+ characters)
# ADMIN_EMAIL=admin@lovable.local
# ADMIN_PASSWORD=

# Show the Google/Facebook buttons before the keys are set (always on for local/testing/development/staging)
# SOCIAL_LOGIN_PREVIEW=true
