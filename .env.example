APP_NAME="Love of My Life"
APP_ENV=production
APP_DEBUG=false
# The public URL of your site (used for canonical/Open Graph/sitemap links)
APP_URL=https://jinelin-basela.markanthonynaluz.com
APP_KEY=
APP_TIMEZONE=UTC
JWT_SECRET=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

# Cookies are marked Secure on HTTPS automatically; set true/false to force it.
SESSION_SECURE=

# ---- Photo uploads (DigitalOcean Spaces) -------------------------------------------------
# Secret typed into the "Add photos" dialog. Uploads are refused while it is empty.
# Generate one with:  php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
UPLOAD_KEY=

SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_REGION=nyc3
# Regional endpoint, without the bucket name
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# Folder (prefix) inside the bucket where photos are stored
SPACES_FOLDER=yam
# Public CDN origin used for the photo links saved to storage/app/carousel.json
SPACES_CDN_URL=
