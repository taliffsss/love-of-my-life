# Ready for local development (php naluz run:server). Production values: deploy/.env.production.example
APP_NAME="Love of My Life"
APP_ENV=local
APP_DEBUG=true
# The public URL of the product (landing page, sign-in, dashboard)
APP_URL=http://localhost:8000
# Domain the pages' own addresses live under: <name>.SAAS_DOMAIN (Forever plan). Defaults to the host of APP_URL.
# Browsers send *.localhost to your machine, so http://<name>.localhost:8000/ works locally.
SAAS_DOMAIN=localhost
APP_KEY=
# (the app always runs in UTC: dates are shown in the product's own zone, saas.display_timezone)
JWT_SECRET=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAYS=14

# Cookies are marked Secure on HTTPS automatically; set true/false to force it.
SESSION_SECURE=

# Accounts, pages, photos and orders. SQLite by default (storage/database.sqlite); MySQL/PostgreSQL also work.
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# PostgreSQL instead (createdb lovable; then php naluz migrate):
# DB_CONNECTION=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=lovable
# DB_USERNAME=you
# DB_PASSWORD=
# (tables go to the database's default schema, public; NaluzPHP 1.3 does not read DB_SCHEMA)

# auto (default) = PayMongo once PAYMONGO_SECRET_KEY is set, otherwise manual
# none = customers see how to pay (GCash/Maya) and you activate the plan: php bin/grant-plan.php <order reference>
# fake = test checkout with a "pay" button (only for APP_ENV=local, testing, development or staging)
# paymongo / xendit = hosted checkout; the provider's webhook marks the order paid (set the keys below)
PAYMENTS_DRIVER=auto
# PAYMENTS_MANUAL_INSTRUCTIONS="Send the amount by GCash to 0917 000 0000 and message us the reference."

# PayMongo: webhook for payment.paid and checkout_session.payment.paid at <APP_URL>/api/webhooks/paymongo (its signing secret below)
PAYMONGO_SECRET_KEY=
# with the public key the order page takes GCash, PayMaya and cards itself; without it PayMongo's hosted checkout page is used
PAYMONGO_PUBLIC_KEY=
# true once PayMongo support has enabled Subscriptions on your account: cards and PayMaya are then charged again automatically
PAYMONGO_SUBSCRIPTIONS=false
PAYMONGO_WEBHOOK_SECRET=
# PAYMONGO_METHODS=gcash,paymaya,card,grab_pay
# GCash and PayMaya on our own order page stay hidden (and their route closed) until PayMongo approves them and this is true. QR Ph is always offered.
PAYMONGO_EWALLET=false
# Visa/Mastercard on our own order page stay hidden (and their route closed) until this is true. GCash, PayMaya and QR Ph are always offered.
PAYMONGO_CARDS=false
# Xendit: Invoices paid + expired webhooks at <APP_URL>/api/webhooks/xendit (the dashboard's verification token below)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---- Photo storage (DigitalOcean Spaces) -------------------------------------------------
# Without these, photos are stored in public/storage (fine for local development only).

SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_REGION=nyc3
# Regional endpoint, without the bucket name
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# Folder (prefix) inside the bucket where photos are stored (pages/<page>/… under it)
SPACES_FOLDER=yam
# Public CDN origin used for the photo links
SPACES_CDN_URL=

# Error reporting to Sentry (sentry.io): server errors and uncaught errors are sent without cookies, headers, request bodies or
# stack-frame arguments. Off while empty. Leave it empty on a developer machine.
SENTRY_DSN=
# SENTRY_NALUZ_DSN works as the name too
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=1.0   (needs the excimer extension; skipped without it)
# SENTRY_ENABLE_LOGS=true
# LOG_CHANNEL=stack
# LOG_STACK=single,sentry_logs
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# Sign in with Google / Facebook (optional; a provider is on when both of its values are set).
# Redirect URIs to register: <APP_URL>/auth/google/callback and <APP_URL>/auth/facebook/callback
# Facebook needs a consumer-login app with the "email" permission (a Business-type app cannot do Facebook Login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_API_VERSION=v26.0

# Mail: sign-up confirmation codes and password reset codes. With a real mailer set, a manual sign-up must confirm its e-mail
# (EMAIL_VERIFICATION=auto|true|false). Resend: smtp.resend.com, port 465 (ssl), user "resend", the API key as the password;
# the From address must be on a domain verified at Resend. The EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD names work too.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=resend
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@loveofmylife.love
# MAIL_FROM_NAME="Love of My Life"
# EMAIL_VERIFICATION=auto

# Administrator for `php naluz db:seed` (required outside local environments, 12+ characters)
# ADMIN_EMAIL=admin@lovable.local
# ADMIN_PASSWORD=

# Show the Google/Facebook buttons before the keys are set (always on for local/testing/development/staging)
# SOCIAL_LOGIN_PREVIEW=true

# After rotating APP_KEY: the old key(s), comma separated, then run php bin/reseal-payments.php (payment data is encrypted with APP_KEY; see DEPLOY.md)
# APP_PREVIOUS_KEYS=

# Google Analytics 4 measurement id (marketing site, sign-in and dashboard; never the pages people make, never /admin).
# Production uses G-M62J7X95ED when this is unset; set it empty to turn analytics off.
GA_MEASUREMENT_ID=

# Feature flag: own addresses (<name>.SAAS_DOMAIN) for Sweetheart and Forever pages. Off by default.
SUBDOMAINS_ENABLED=false

# Who runs the service, printed in the Terms and the Privacy Policy. Set the real operator (your name or registered business) and a mailbox
# that is read: privacy requests, takedown reports and support all go there. LEGAL_DPO_NAME is optional.
LEGAL_OPERATOR_NAME=Love of My Life
LEGAL_ADDRESS=Philippines
LEGAL_CONTACT_EMAIL=hello@loveofmylife.love
LEGAL_DPO_NAME=
