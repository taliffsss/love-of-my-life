---
import fs from 'node:fs';
import path from 'node:path';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const exts = /\.(jpe?g|png|webp|gif|avif)$/i;

// Every image dropped into public/photos becomes a slide (natural filename order).
const dir = path.resolve('public/photos');
const photos = (fs.existsSync(dir) ? fs.readdirSync(dir) : [])
  .filter((f) => exts.test(f))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((f) => `${base}/photos/${encodeURIComponent(f)}`);

// Song: first audio file found in public/music (janice.mp3 expected).
const musicDir = path.resolve('public/music');
const song = (fs.existsSync(musicDir) ? fs.readdirSync(musicDir) : []).find((f) =>
  /\.(mp3|m4a|ogg|wav)$/i.test(f),
);
const music = song ? `${base}/music/${encodeURIComponent(song)}` : '';

// Soft gradient placeholders until real photos are added.
const placeholders = ['#f9d5d3,#e8a5b5', '#fbe3d0,#f2b8a2', '#e6d3f0,#c9a6dc', '#ffe8e0,#f5b7c4'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a0d17" />
    <meta name="robots" content="noindex" />
    <title>For My Love</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="hearts" aria-hidden="true"></div>

    <!-- Slideshow (plays from the start, blurred behind the modal) -->
    <section id="show" class="show on locked" aria-label="Photo slideshow">
      <div class="stage" id="stage">
        {
          (photos.length ? photos : placeholders).map((src, i) => (
            <figure class="slide" data-i={i}>
              {photos.length ? (
                <>
                  <img class="bg" src={src} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                  <img class="fg" src={src} alt={`Memory ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                </>
              ) : (
                <div class="ph" style={`background:linear-gradient(135deg,${src})`}>
                  <span>Add your photos to <code>public/photos</code></span>
                </div>
              )}
            </figure>
          ))
        }
      </div>
      <div class="vignette"></div>
      <div class="glow"></div>
      <button class="nav prev" id="prev" aria-label="Previous photo"></button>
      <button class="nav next" id="next" aria-label="Next photo"></button>
      <div class="hud">
        <span class="count" id="count" aria-hidden="true">01 / 01</span>
        <div class="bar" aria-hidden="true"><i id="barfill"></i></div>
      </div>
      <button class="mute" id="mute" aria-label="Toggle music" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2v12"/><circle cx="6.500" cy="18" r="2.500"/><circle cx="16.500" cy="16" r="2.500"/></svg>
      </button>
    </section>

    <!-- Password modal -->
    <main id="gate" class="gate">
      <form id="form" class="card" autocomplete="off">
        <div class="lock" id="lock" aria-hidden="true">
          <svg viewBox="0 0 64 72" width="34" height="38">
            <path class="shackle" d="M20 32V22a12 12 0 0 1 24 0v10" fill="none" stroke="currentColor" stroke-width="4.500" stroke-linecap="round"/>
            <rect x="10" y="30" width="44" height="34" rx="10" fill="currentColor"/>
            <path d="M32 55s-9-5.500-9-11.200c0-3 2.300-5 4.800-5 1.700 0 3.400.9 4.200 2.400.8-1.500 2.500-2.400 4.200-2.400 2.500 0 4.800 2 4.800 5C41 49.500 32 55 32 55z" fill="#2a1220" opacity=".85"/>
          </svg>
        </div>
        <p class="eyebrow">For my love</p>
        <label for="pw" class="question">What is your endearment?</label>
        <div class="field">
          <input
            id="pw"
            type="password"
            inputmode="text"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            placeholder="Type it here"
            aria-describedby="err"
            required
          />
          <button type="submit" aria-label="Unlock">
            <svg class="i-arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <svg class="i-heart" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 21s-8-4.900-8-11.100C4 6.700 6.300 5 8.600 5c1.500 0 2.900.8 3.400 2 .5-1.200 1.900-2 3.400-2C17.700 5 20 6.700 20 9.900 20 16.100 12 21 12 21z"/></svg>
          </button>
        </div>
        <p id="err" class="err" role="alert" aria-live="polite"></p>
      </form>
    </main>

    {music && <audio id="song" src={music} loop preload="auto"></audio>}
  </body>
</html>

<style is:global>
  :root {
    --bg: #160a14;
    --plum: #2a1220;
    --rose: #f2a7b8;
    --rose-deep: #d9728c;
    --gold: #f0cfa8;
    --text: #fbeef0;
    --muted: rgba(251, 238, 240, .62);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --soft: cubic-bezier(0.45, 0, 0.2, 1);
    --slide-ms: 8000ms;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--text);
    background: var(--bg);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }
  [hidden] { display: none !important; }
  button { font: inherit; }

  /* ---------- floating hearts ---------- */
  .hearts { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 12; }
  .heart {
    position: absolute; bottom: -8vh; left: var(--x);
    font-size: var(--s); line-height: 1; color: var(--rose);
    opacity: 0; filter: drop-shadow(0 0 8px rgba(242, 167, 184, .55));
    animation: rise var(--d) var(--soft) var(--delay) infinite;
    will-change: transform, opacity;
  }
  @keyframes rise {
    0%   { transform: translate3d(0, 0, 0) scale(.7); opacity: 0; }
    12%  { opacity: var(--o); }
    35%  { transform: translate3d(calc(var(--sway) * 1), -38vh, 0) scale(.95); }
    65%  { transform: translate3d(calc(var(--sway) * -1), -78vh, 0) scale(1.05); }
    100% { transform: translate3d(calc(var(--sway) * .4), -118vh, 0) scale(1.1); opacity: 0; }
  }

  /* ---------- slideshow ---------- */
  .show {
    position: fixed; inset: 0; z-index: 5; background: var(--bg); overflow: hidden;
    opacity: 0; transition: opacity 1.4s ease, filter 2.6s var(--soft), transform 2.8s var(--ease);
    will-change: filter, transform;
  }
  .show.on { opacity: 1; }
  .show.locked { filter: blur(70px) brightness(.5) saturate(1.3); transform: scale(1.25); }
  .stage, .slide { position: absolute; inset: 0; margin: 0; }
  .slide { opacity: 0; transition: opacity 2.4s var(--soft); overflow: hidden; }
  .slide.active { opacity: 1; z-index: 2; }
  .slide.out { z-index: 1; }
  .slide .bg {
    position: absolute; inset: -8%; width: 116%; height: 116%; object-fit: cover;
    filter: blur(34px) brightness(.62) saturate(1.25);
  }
  .slide .fg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    will-change: transform; transform-origin: 50% 45%;
  }
  .ph { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 2rem; color: #fff; font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-style: italic; }
  .ph code { font-family: Inter, sans-serif; font-style: normal; font-size: .8em; background: rgba(255,255,255,.22); padding: .1em .45em; border-radius: 6px; }

  /* slow drifting zoom; stays on while the slide fades out, so nothing snaps */
  .slide.play.fx0 .fg, .slide.play.fx0 .ph { animation: kb0 14s var(--soft) both; }
  .slide.play.fx1 .fg, .slide.play.fx1 .ph { animation: kb1 14s var(--soft) both; }
  .slide.play.fx2 .fg, .slide.play.fx2 .ph { animation: kb2 14s var(--soft) both; }
  .slide.play.fx3 .fg, .slide.play.fx3 .ph { animation: kb3 14s var(--soft) both; }
  @keyframes kb0 { from { transform: scale(1.1); } to { transform: scale(1.01); } }
  @keyframes kb1 { from { transform: scale(1.02) translate3d(2.5%, 0, 0); } to { transform: scale(1.09) translate3d(-1.5%, 0, 0); } }
  @keyframes kb2 { from { transform: scale(1.02); } to { transform: scale(1.1); } }
  @keyframes kb3 { from { transform: scale(1.02) translate3d(-2.5%, 0, 0); } to { transform: scale(1.09) translate3d(1.5%, 0, 0); } }

  .vignette { position: absolute; inset: 0; z-index: 3; pointer-events: none; background: radial-gradient(ellipse at 50% 45%, transparent 50%, rgba(22, 8, 20, .55) 100%), linear-gradient(to top, rgba(22, 8, 20, .55), transparent 28%); }
  .glow {
    position: absolute; inset: -20%; z-index: 3; pointer-events: none; mix-blend-mode: soft-light;
    background: radial-gradient(40% 35% at 20% 15%, rgba(255, 190, 150, .55), transparent 70%), radial-gradient(45% 40% at 85% 90%, rgba(242, 130, 170, .5), transparent 70%);
    animation: glow 12s ease-in-out infinite alternate;
  }
  @keyframes glow { from { transform: translate3d(-3%, -2%, 0) scale(1); opacity: .7; } to { transform: translate3d(3%, 2%, 0) scale(1.08); opacity: 1; } }

  .nav { position: absolute; top: 0; bottom: 0; z-index: 6; width: 28%; border: 0; background: transparent; cursor: pointer; }
  .nav.prev { left: 0; } .nav.next { right: 0; }

  .hud { position: absolute; z-index: 7; left: 24px; right: 24px; bottom: max(22px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 14px; pointer-events: none; }
  .count { font-size: .72rem; letter-spacing: .22em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .bar { flex: 1; height: 2px; border-radius: 2px; background: rgba(255, 255, 255, .2); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 100%; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, var(--rose), var(--gold)); }
  .bar i.run { animation: fill var(--slide-ms) linear forwards; }
  @keyframes fill { to { transform: scaleX(1); } }

  .mute {
    position: absolute; z-index: 8; top: max(16px, env(safe-area-inset-top)); right: 16px; width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid rgba(255, 255, 255, .22); background: rgba(255, 255, 255, .1); color: #fff; cursor: pointer;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); transition: transform .3s var(--ease), background .3s, opacity .3s;
    animation: pop .9s var(--ease) both;
  }
  .mute:hover { background: rgba(255, 255, 255, .18); }
  .mute:active { transform: scale(.94); }
  .mute.off { opacity: .5; }
  @keyframes pop { from { opacity: 0; transform: scale(.7); } }

  /* ---------- password modal ---------- */
  .gate {
    position: fixed; inset: 0; z-index: 10; display: grid; place-items: center;
    padding: max(20px, env(safe-area-inset-top)) 20px max(20px, env(safe-area-inset-bottom));
    background: linear-gradient(160deg, rgba(34, 12, 30, .6), rgba(110, 36, 70, .4));
    transition: opacity 1.8s var(--soft), background 1.8s var(--soft);
  }
  .gate::after {            /* soft bloom of light at the moment of unlocking */
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at 50% 50%, rgba(255, 226, 214, .85), rgba(242, 167, 184, .35) 38%, transparent 68%);
  }
  .card {
    position: relative; width: min(92vw, 380px); padding: 2.2rem 1.7rem 1.7rem; text-align: center;
    background: linear-gradient(160deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, .06));
    border: 1px solid rgba(255, 255, 255, .22); border-radius: 30px;
    backdrop-filter: blur(22px) saturate(1.3); -webkit-backdrop-filter: blur(22px) saturate(1.3);
    box-shadow: 0 30px 80px rgba(10, 2, 10, .5), inset 0 1px 0 rgba(255, 255, 255, .25);
    animation: cardIn 1.5s var(--ease) both;
    transition: transform 1.5s var(--ease), opacity 1.2s var(--soft), filter 1.4s var(--soft), box-shadow 1.2s var(--soft);
  }
  @keyframes cardIn { from { opacity: 0; transform: translate3d(0, 28px, 0) scale(.96); filter: blur(8px); } }
  .card > * { animation: fadeUp 1.2s var(--ease) both; }
  .card > .lock { animation-delay: .25s; } .card > .eyebrow { animation-delay: .4s; }
  .card > .question { animation-delay: .55s; } .card > .field { animation-delay: .7s; } .card > .err { animation-delay: .8s; }
  @keyframes fadeUp { from { opacity: 0; transform: translate3d(0, 12px, 0); } }

  .lock { display: inline-grid; place-items: center; width: 62px; height: 62px; border-radius: 50%; color: var(--rose); margin-bottom: 1rem;
    background: radial-gradient(circle, rgba(242, 167, 184, .22), rgba(242, 167, 184, .04) 70%); border: 1px solid rgba(242, 167, 184, .3);
    animation: fadeUp 1.2s var(--ease) .25s both, breathe 4s ease-in-out 1.5s infinite; }
  .shackle { transform-origin: 44px 32px; transition: transform 1s var(--ease); }
  @keyframes breathe { 0%, 100% { box-shadow: 0 0 0 0 rgba(242, 167, 184, .35); } 50% { box-shadow: 0 0 0 14px rgba(242, 167, 184, 0); } }

  .eyebrow { margin: 0 0 .5rem; font-size: .68rem; letter-spacing: .38em; text-transform: uppercase; color: var(--gold); }
  .question {
    display: block; margin-bottom: 1.6rem; font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-weight: 400;
    font-size: clamp(1.9rem, 8.5vw, 2.4rem); line-height: 1.12; color: var(--text);
  }
  .field { position: relative; }
  #pw {
    width: 100%; height: 56px; padding: 0 64px 0 22px; font: inherit; font-size: 1rem; letter-spacing: .12em; color: var(--text);
    background: rgba(255, 255, 255, .09); border: 1px solid rgba(255, 255, 255, .22); border-radius: 999px; outline: none;
    transition: border-color .4s var(--soft), box-shadow .4s var(--soft), background .4s var(--soft);
  }
  #pw::placeholder { color: rgba(251, 238, 240, .42); letter-spacing: .04em; }
  #pw:focus { border-color: rgba(242, 167, 184, .8); background: rgba(255, 255, 255, .13); box-shadow: 0 0 0 5px rgba(242, 167, 184, .16), 0 0 30px rgba(242, 167, 184, .25); }
  .field button {
    position: absolute; top: 6px; right: 6px; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; cursor: pointer; color: #2a1220;
    background: linear-gradient(135deg, var(--gold), var(--rose)); box-shadow: 0 6px 18px rgba(217, 114, 140, .45); transition: transform .35s var(--ease), box-shadow .35s;
  }
  .field button:hover { transform: scale(1.06); }
  .field button:active { transform: scale(.94); }
  .field button svg { grid-area: 1 / 1; transition: opacity .5s var(--soft), transform .6s var(--ease); }
  .i-heart { opacity: 0; transform: scale(.4); }
  .err { min-height: 1.3em; margin: .9rem 0 0; font-size: .82rem; color: var(--rose); letter-spacing: .02em; }
  .card.shake { animation: shake .55s var(--soft); }
  @keyframes shake { 15%, 55% { transform: translateX(-8px); } 35%, 75% { transform: translateX(8px); } }

  /* ---------- unlock sequence ---------- */
  .gate.unlocking .shackle { transform: translateY(-9px) rotate(30deg); }
  .gate.unlocking .i-arrow { opacity: 0; transform: scale(.4); }
  .gate.unlocking .i-heart { opacity: 1; transform: scale(1); animation: beat .9s var(--ease) both; }
  .gate.unlocking .card { transform: scale(1.03); box-shadow: 0 0 80px 10px rgba(242, 167, 184, .45), 0 30px 80px rgba(10, 2, 10, .5), inset 0 1px 0 rgba(255, 255, 255, .25); }
  @keyframes beat { 0% { transform: scale(.4); } 55% { transform: scale(1.35); } 100% { transform: scale(1); } }
  .gate.leaving { opacity: 0; background: rgba(34, 12, 30, 0); pointer-events: none; }
  .gate.leaving::after { animation: bloom 2.2s var(--soft) both; }
  .gate.leaving .card { opacity: 0; transform: translate3d(0, -26px, 0) scale(1.07); filter: blur(10px); }
  @keyframes bloom { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .heart, .glow, .lock { animation: none; }
    .slide.play .fg, .slide.play .ph { animation: none !important; }
    .slide { transition-duration: 1s; }
  }
</style>

<script>
  const PASSWORD = 'yam';
  const SLIDE_MS = 8000;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const gate = $('gate'), form = $<HTMLFormElement>('form'), pw = $<HTMLInputElement>('pw');
  const err = $('err'), show = $('show'), muteBtn = $('mute');
  const countEl = $('count'), barFill = $('barfill');
  const audio = document.getElementById('song') as HTMLAudioElement | null;
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // floating hearts
  const hearts = document.querySelector('.hearts')!;
  const heartCount = reduced ? 0 : innerWidth < 600 ? 10 : 18;
  for (let i = 0; i < heartCount; i++) {
    const h = document.createElement('span');
    h.className = 'heart';
    h.textContent = '\u2665';
    h.style.cssText = `--x:${Math.random() * 96}vw;--s:${10 + Math.random() * 16}px;--d:${16 + Math.random() * 14}s;--delay:${-Math.random() * 30}s;--sway:${12 + Math.random() * 22}px;--o:${0.25 + Math.random() * 0.4}`;
    hearts.appendChild(h);
  }

  // slideshow
  let cur = -1, timer = 0, started = false;
  const pad = (n: number) => String(n).padStart(2, '0');

  function go(n: number) {
    const next = (n + slides.length) % slides.length;
    if (next === cur) return;
    const prev = slides[cur];
    if (prev) {
      prev.classList.remove('active');
      prev.classList.add('out');
      setTimeout(() => prev.classList.remove('out', 'play'), 2600);
    }
    const s = slides[next];
    s.className = s.className.replace(/\b(fx\d|out|play)\b/g, '').trim();
    void s.offsetWidth; // restart the drift animation from its first frame
    s.classList.add('play', `fx${next % 4}`, 'active');
    countEl.textContent = `${pad(next + 1)} / ${pad(slides.length)}`;
    cur = next;
    restart();
  }
  function restart() {
    clearInterval(timer);
    barFill.classList.remove('run');
    void barFill.offsetWidth;
    if (slides.length > 1) {
      barFill.classList.add('run');
      timer = window.setInterval(() => go(cur + 1), SLIDE_MS);
    }
  }
  $('next').onclick = () => started && go(cur + 1);
  $('prev').onclick = () => started && go(cur - 1);
  let tx = 0;
  show.addEventListener('touchstart', (e) => (tx = e.touches[0].clientX), { passive: true });
  show.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - tx;
    if (started && Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1));
  });
  addEventListener('keydown', (e) => {
    if (!started) return;
    if (e.key === 'ArrowRight') go(cur + 1);
    if (e.key === 'ArrowLeft') go(cur - 1);
  });
  go(0); // slideshow plays behind the modal from the start

  // music: a local file in public/music wins, otherwise the song streams from YouTube's official embed
  type Music = { start(): void; toggle(): boolean; fadeIn(): void };
  const YT_ID = '-sNgBet587k';
  const TARGET = 80;

  function localMusic(a: HTMLAudioElement): Music {
    return {
      start() { a.volume = 0; a.play().catch(() => {}); },
      toggle() { if (a.paused) { a.play(); return true; } a.pause(); return false; },
      fadeIn() {
        let v = 0;
        const t = setInterval(() => { v = Math.min(TARGET, v + 2); a.volume = v / 100; if (v >= TARGET) clearInterval(t); }, 120);
      },
    };
  }

  function youtubeMusic(): Music {
    let player: any = null, ready = false, wantPlay = false, playing = false;
    const holder = document.createElement('div');
    holder.id = 'yt';
    holder.style.cssText = 'position:fixed;left:-9999px;top:0;width:200px;height:200px;opacity:0;pointer-events:none';
    document.body.appendChild(holder);
    (window as any).onYouTubeIframeAPIReady = () => {
      player = new (window as any).YT.Player('yt', {
        width: 200, height: 200, videoId: YT_ID,
        playerVars: { controls: 0, loop: 1, playlist: YT_ID, playsinline: 1, rel: 0, modestbranding: 1 },
        events: {
          onReady: () => { ready = true; player.setVolume(0); if (wantPlay) player.playVideo(); },
          onError: () => { muteBtn.hidden = true; },
        },
      });
    };
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(tag);
    return {
      start() { wantPlay = true; playing = true; if (ready) { player.setVolume(0); player.playVideo(); } },
      toggle() {
        if (!ready) return playing;
        if (playing) { player.pauseVideo(); playing = false; } else { player.playVideo(); playing = true; }
        return playing;
      },
      fadeIn() {
        let v = 0;
        const t = setInterval(() => {
          v = Math.min(TARGET, v + 2);
          if (ready) player.setVolume(v);
          if (v >= TARGET) clearInterval(t);
        }, 120);
      },
    };
  }

  const music: Music = audio ? localMusic(audio) : youtubeMusic();
  muteBtn.onclick = () => muteBtn.classList.toggle('off', !music.toggle());

  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? Math.min(ms, 150) : ms));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (started) return;
    if (pw.value.trim().toLowerCase() !== PASSWORD) {
      err.textContent = 'Not quite, my love. Try again.';
      form.classList.remove('shake'); void form.offsetWidth; form.classList.add('shake');
      pw.select();
      return;
    }
    started = true;
    pw.blur();
    err.textContent = '';
    // start playback inside the tap (mobile browsers require it), silent until the reveal
    music.start();

    gate.classList.add('unlocking');
    await wait(1200);
    gate.classList.add('leaving');
    show.classList.remove('locked');
    muteBtn.hidden = false;
    music.fadeIn();
    await wait(2200);
    gate.remove();
  });
</script>
