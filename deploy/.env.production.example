# Copy to `deploy/.env.production` on the server (next to docker-stack.yml). Never commit the real one. Docker's env_file keeps quotes literally,
# so write values WITHOUT quotes.
APP_NAME=Love of My Life
APP_ENV=production
APP_DEBUG=false
APP_URL=https://jinelin-basela.markanthonynaluz.com
# php naluz key:generate --show   (or: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;")
APP_KEY=
JWT_SECRET=
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Secret typed into the upload dialogs (photos and song). Uploads are refused while empty.
UPLOAD_KEY=jinelin basela

SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_FOLDER=yam
SPACES_CDN_URL=
