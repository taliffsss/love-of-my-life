# Copy to `deploy/.env.production` on the server (next to docker-stack.yml). Never commit the real one. Docker's env_file keeps quotes literally,
# so write values WITHOUT quotes.
APP_NAME=Love of My Life
APP_ENV=production
APP_DEBUG=false
# The product's own address (landing page, sign-in, dashboard). An original single-page site, if you move one in, becomes a page
# on its own domain (php bin/import-legacy.php --domain=old-site.example.com …).
APP_URL=https://loveofmylife.love
# php naluz key:generate --show   (or: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;")
APP_KEY=
JWT_SECRET=
# (the app always runs in UTC; APP_TIMEZONE is ignored. Dates are shown in the product's own zone, saas.display_timezone)

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The domain page addresses (<name>.SAAS_DOMAIN) would live under. Defaults to the host of APP_URL.
SAAS_DOMAIN=loveofmylife.love
# Feature flag: own addresses (<name>.SAAS_DOMAIN) for Sweetheart and Forever pages. Off for now. Turning it on also needs the wildcard
# DNS record, the wildcard certificate and the commented labels in docker-stack.yml (DEPLOY.md, "Own addresses").
SUBDOMAINS_ENABLED=false

# Google Analytics 4 measurement id (marketing site, sign-in and dashboard; never the pages people make, never /admin).
# Production uses G-M62J7X95ED when this is unset; set it empty to turn analytics off.
GA_MEASUREMENT_ID=G-M62J7X95ED

# none = manual payments (php bin/grant-plan.php <order reference>); never "fake" in production
PAYMENTS_DRIVER=none
PAYMENTS_MANUAL_INSTRUCTIONS=Send the amount by GCash or Maya and reply with your order reference; your page goes live as soon as we confirm it.

# SQLite in the storage volume; migrations run at start (RUN_MIGRATIONS=false to run them by hand)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
RUN_MIGRATIONS=true
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_FOLDER=yam
SPACES_CDN_URL=

# Mail (Resend): confirmation and password reset codes. The release workflow writes these from the SAAS_MAIL_* secrets when they are set.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@loveofmylife.love
MAIL_FROM_NAME=Love of My Life

# The first administrator: created at start when no account has this e-mail (12+ character password); an existing account is never changed.
# The release workflow writes these from the ADMIN_EMAIL and ADMIN_PASSWORD secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A normal account for testing the live site: created at start when no account has this e-mail (12+ character password); an existing
# account is never changed. The release workflow writes these from the QA_EMAIL and QA_PASSWORD secrets.
QA_EMAIL=
QA_PASSWORD=

# PayMongo. The release workflow writes all of these from GitHub: the secrets PAYMENTS_DRIVER, PAYMONGO_SECRET_KEY, PAYMONGO_PUBLIC_KEY
# and PAYMONGO_WEBHOOK_SECRET, and the variables PAYMONGO_SUBSCRIPTIONS and PAYMONGO_EWALLET (both false until PayMongo approves them).
# QR Ph is always offered; PAYMONGO_EWALLET=true adds GCash and PayMaya.
PAYMONGO_SUBSCRIPTIONS=false
PAYMONGO_EWALLET=false

# Sentry error reporting (the release workflow writes it from the SENTRY_DSN secret or variable; empty = off).
SENTRY_DSN=

# Who runs the service, printed in the Terms and the Privacy Policy. Set the real operator (your name or registered business) and a mailbox
# that is read: privacy requests, takedown reports and support all go there. LEGAL_DPO_NAME is optional.
LEGAL_OPERATOR_NAME=Love of My Life
LEGAL_ADDRESS=Philippines
LEGAL_CONTACT_EMAIL=hello@loveofmylife.love
LEGAL_DPO_NAME=

# Sign in with Facebook (Meta app). Valid OAuth Redirect URI to register at Meta: https://loveofmylife.love/auth/facebook/callback
# Never commit the real values; put them only in the server's .env.production.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
